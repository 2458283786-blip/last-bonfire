[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/dungeon_hud.gd" id="1_hud"]

[node name="DungeonHUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="VBox" type="VBoxContainer" parent="."]
offset_left = 30.0
offset_top = 24.0
offset_right = 600.0
offset_bottom = 180.0
theme_override_constants/separation = 8

[node name="TimeLabel" type="Label" parent="VBox"]
theme_override_colors/font_color = Color(1, 0.85, 0.4, 1)
theme_override_font_sizes/font_size = 28
text = "距天黑 0 秒"

[node name="StatusLabel" type="Label" parent="VBox"]
theme_override_colors/font_color = Color(0.85, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 18
text = "小心：探索越久，城镇越危险"

[node name="HintLabel" type="Label" parent="VBox"]
theme_override_colors/font_color = Color(0.7, 0.7, 0.75, 1)
theme_override_font_sizes/font_size = 16
text = "按 E 交互 · J 近战 · K 弓箭"
